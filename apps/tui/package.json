{
  "name": "spotoei-tui",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "spotoei": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run ../../scripts/dev.ts",
    "build": "bun build ./src/main.ts --compile --target=bun --outfile=dist/spotoei",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "spotoei-protocol": "workspace:*"
  }
}
