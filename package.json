{
  "name": "spotoei",
  "version": "0.1.0",
  "private": true,
  "description": "SPOTOEI — keyboard-first, terminal-native Spotify client.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run apps/tui/src/main.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:logs": "bun run scripts/devLogs.ts",
    "build": "bun run --filter spotoei-protocol build && bun run --filter spotoei-tui build",
    "test": "bun test",
    "lint": "oxlint . && bun scripts/check-loc.ts",
    "check:loc": "bun scripts/check-loc.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter spotoei-tui typecheck",
    "package": "bun run scripts/package.ts"
  },
  "devDependencies": {
    "@types/bun": "*",
    "@types/node": "^26.4.1",
    "oxfmt": "*",
    "oxlint": "*",
    "typescript": "*"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
